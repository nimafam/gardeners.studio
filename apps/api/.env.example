NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://gardeners:gardeners_local_password@localhost:5433/gardeners?schema=public

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=replace-with-a-strong-password
SEED_OWNER_FIRST_NAME=Gardeners
SEED_OWNER_LAST_NAME=Admin
